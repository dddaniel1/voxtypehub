#!/usr/bin/env python3
import datetime, json, pathlib, sqlite3, sys, urllib.request

base = pathlib.Path.home() / '.config/voxtype'
profile_file = base / 'active-profile'
profile = sys.argv[1] if len(sys.argv) == 2 else (profile_file.read_text().strip() if profile_file.exists() else 'general')
if len(sys.argv) > 2 or not profile or any(c not in 'abcdefghijklmnopqrstuvwxyz0123456789_' for c in profile):
    sys.exit(1)
text = sys.stdin.read()
if not text.strip():
    sys.exit(1)
setting = base / 'postprocess-enabled'
if setting.exists() and setting.read_text().strip() == '0':
    sys.stdout.write(text)
    sys.exit(0)
output = text
success = False
try:
    providers_path = base / 'providers.json'
    if providers_path.exists():
        providers = json.loads(providers_path.read_text())
        active = providers['active']
        settings = next(item for item in providers['items'] if item['id'] == active)
        key_path = base / ('deepseek-api-key' if active == 'legacy' else 'provider-key-' + active)
    else:
        settings_path = base / 'provider.json'
        settings = json.loads(settings_path.read_text()) if settings_path.exists() else {'url':'https://api.deepseek.com/chat/completions','model':'deepseek-flash'}
        key_path = base / 'deepseek-api-key'
    if not settings['url'].startswith('https://'):
        raise ValueError('HTTPS required')
    key = key_path.read_text().strip()
    prompt = json.loads((base / 'prompts.json').read_text())[profile]
    payload = {'model': settings['model'], 'messages': [{'role':'system','content':prompt}, {'role':'user','content':text}], 'temperature':0.2}
    if settings['url'].startswith('https://api.deepseek.com/'):
        payload['thinking'] = {'type':'disabled'}
    request = urllib.request.Request(settings['url'], data=json.dumps(payload,ensure_ascii=False).encode(), headers={'Authorization':'Bearer '+key,'Content-Type':'application/json'})
    with urllib.request.urlopen(request, timeout=25) as response:
        choice = json.load(response)['choices'][0]
    if choice['finish_reason'] != 'stop' or not choice['message']['content'].strip():
        raise ValueError('incomplete or empty response')
    output = choice['message']['content'].strip()
    success = True
except Exception as error:
    print(f'Post-processing failed: {type(error).__name__}', file=sys.stderr)
try:
    path = base / 'history.sqlite3'
    path.touch(mode=0o600, exist_ok=True)
    with sqlite3.connect(path, timeout=2) as db:
        db.execute('CREATE TABLE IF NOT EXISTS history (id INTEGER PRIMARY KEY, created TEXT, profile TEXT, input TEXT, output TEXT, success INTEGER)')
        db.execute('INSERT INTO history (created,profile,input,output,success) VALUES (?,?,?,?,?)', (datetime.datetime.now().astimezone().isoformat(timespec='seconds'),profile,text,output,int(success)))
except Exception as error:
    print(f'History save failed: {type(error).__name__}', file=sys.stderr)
if success:
    print(output)
else:
    sys.exit(1)
